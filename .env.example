# Local development needs nothing here: the API serves a local store under .data/ and
# falls back to the rule engine when no model is configured.

# Model providers to try, in order: bedrock (Amazon Nova Micro, then Nova Lite), nebius (optional), or off
DIALED_LLM=bedrock
# Spending guard: model-assisted captures per UTC day
DIALED_LLM_DAILY_CAP=400
# Set by the CloudFormation stack in production
DIALED_TABLE=
DIALED_BUCKET=
AWS_REGION=ap-southeast-2
